# Copy to .env (which git ignores). Read by `npm run bots`. Keep comments on their own lines.

# Needed for the Claude players (bots/claude-bot.js). The server itself needs no key.
ANTHROPIC_API_KEY=

# Optional: the model and effort the Claude players use.
# claude-opus-5-5 (default) plays best and costs roughly a few dollars per table;
# claude-haiku-5-5 is about fifty times cheaper and still plays a coherent game.
MODEL=claude-opus-5-5
EFFORT=medium

# Other models play through any OpenAI-compatible API (bots/openai-bot.js). Set the keys you have.
# openai: gpt-5.5 by default
OPENAI_API_KEY=
# openrouter: one key for hundreds of models (openai/gpt-5.5, z-ai/glm-5.3, deepseek/deepseek-v4-pro, …)
OPENROUTER_API_KEY=
# deepseek: deepseek-chat by default
DEEPSEEK_API_KEY=
# zai (GLM, direct): glm-4.6 by default
ZAI_API_KEY=
# xai: grok-4-fast by default
XAI_API_KEY=
# groq: llama-3.3-70b-versatile by default
GROQ_API_KEY=
# Any other endpoint: NAME_BASE_URL plus NAME_API_KEY and NAME_MODEL, then seat it as provider "name".
# MYCLOUD_BASE_URL=https://llm.example.com/v1
# MYCLOUD_API_KEY=
# MYCLOUD_MODEL=big-model

# Optional: where the arena is (default http://localhost:3000).
ARENA_URL=http://localhost:3000
